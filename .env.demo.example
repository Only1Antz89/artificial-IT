# Copy to .env before `docker compose -f docker-compose.demo.yml up --build`.
#
# The two tokens below are the only required values. They are separate on
# purpose: AIT presents the first to the gateway, the gateway presents the
# second to the desktop bridge, and holding one must not get you the other.
# Generate them rather than using these: `openssl rand -hex 24`.
OPENCLAW_BRIDGE_RUNTIME_TOKEN=change-me-gateway
AILLIUM_DESKTOP_BRIDGE_TOKEN=change-me-bridge

# Host ports. Change these if something already has them.
AIT_CONSOLE_PORT=3110
AIT_PORTAL_PORT=3111
OPENCLAW_PORT=18789

# Optional: a reasoning provider. With neither key set, AIT runs its
# deterministic playbook engine, and the whole demo still works.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AIT_PROVIDER=offline

# Optional: a real endpoint over MeshCentral. Unset, the Operations card
# reports MeshCentral as UNAVAILABLE rather than pretending.
# MESHCENTRAL_URL=https://mesh.example.internal
# MESHCENTRAL_TOKEN=
# MESHCENTRAL_MESH_ID=mesh/domain/id
# MESHCENTRAL_DEVICE_ID=node/domain/id

# Optional: a real help desk.
# ZENDESK_SUBDOMAIN=
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=
