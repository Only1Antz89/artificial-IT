# Reasoning provider. One of: claude | openai | offline | auto (default).
# `auto` picks the first configured provider, falling back to the offline
# playbook engine so the demo runs with no credentials at all.
AIT_PROVIDER=auto

# Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# Zendesk. Without these, the in-memory help desk is used.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# MeshCentral remote sessions. Without these, simulated devices are used.
MESHCENTRAL_URL=
MESHCENTRAL_TOKEN=
MESHCENTRAL_MESH_ID=

# Console port
PORT=3000
