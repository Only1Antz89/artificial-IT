# Reasoning provider. One of: claude | openai | gemini | offline | auto (default).
# `auto` picks the first configured provider, falling back to the offline
# playbook engine so the demo runs with no credentials at all.
AIT_PROVIDER=auto

# Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro

# Zendesk. Without these, the in-memory help desk is used.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# MeshCentral remote sessions. Without these, simulated or local devices are used.
# Use either MESHCENTRAL_TOKEN (a server login key/cookie) or a generated
# MeshCentral login-token username/password pair.
MESHCENTRAL_URL=
MESHCENTRAL_TOKEN=
# MESHCENTRAL_USER=~t:ait-operator
# MESHCENTRAL_PASSWORD=
MESHCENTRAL_MESH_ID=
MESHCENTRAL_DEVICE_ID=
# MESHCENTRAL_DEVICE_NAME=LON-LT-2211
# MESHCENTRAL_DEVICE_PLATFORM=windows
# TLS verification is never disabled. If your MeshCentral uses a private CA,
# trust it here rather than weakening verification.
# NODE_EXTRA_CA_CERTS=/path/to/ca.pem

# Alternative project's curated OpenClaw gateway. The gateway owns the
# connection to UI-TARS Desktop; AIT never sends desktop input around that
# governed boundary.
# Plain HTTP is accepted only for a loopback URL.
OPENCLAW_BRIDGE_URL=http://127.0.0.1:18789
OPENCLAW_BRIDGE_RUNTIME_TOKEN=
# OPENCLAW_BRIDGE_TIMEOUT_MS=5000
# The gateway's path prefix, when you already know it: `ait` for
# /api/desktop/*, `aillium` for /api/aillium/desktop/*. Left unset, AIT finds
# out with a read-only probe and then holds the answer.
# OPENCLAW_BRIDGE_DIALECT=aillium

# The host's terminal channel, for the demo stack. See DEMO_STACK.md.
# AILLIUM_DESKTOP_BRIDGE_URL=http://127.0.0.1:47891
# AILLIUM_DESKTOP_BRIDGE_TOKEN=

# Where desktop authority comes from. AIT never mints it for a real bridge:
# point this at the issuer...
# AIT_DESKTOP_AUTHORITY_URL=https://issuer.internal/desktop-authority
# AIT_DESKTOP_AUTHORITY_TOKEN=
# ...or opt in to a clearly-labelled simulated grant, for the demo stack only.
# AIT_SIMULATED_DESKTOP_AUTHORITY=1

# Console port
PORT=3000
